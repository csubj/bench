{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "shellTools": { "bg_run": { "commandArgument": "command" } },
  "permission": {
    "*": "ask",

    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "*/id_rsa": "deny",
      "*/id_ed25519": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*secrets*": "deny",
      "*credentials*": "deny",
      "*/mcp.local.json": "deny",
      "*/auth.json": "deny"
    },

    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "edit": "allow",
    "write": "allow",

    "bash": {
      "*": "ask",

      "cd *": "allow",

      "pwd": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "true": "allow",
      "test *": "allow",
      "tr *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "awk *": "ask",
      "sed *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "tee *": "allow",
      "xargs *": "ask",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote -v": "allow",
      "git remote *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git stash list": "allow",
      "git tag *": "allow",
      "git config *": "allow",
      "git add *": "allow",
      "git mv *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git stash *": "allow",
      "git fetch *": "allow",

      "git commit *": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git push -f *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask",
      "git rm *": "ask",

      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rmdir *": "allow",
      "ln *": "allow",
      "chmod *": "allow",

      "cargo *": "allow",
      "rustc *": "allow",
      "rustup *": "allow",
      "~/.cargo/bin/cargo *": "allow",
      "xcodebuild *": "allow",
      "xcrun *": "allow",
      "swift *": "allow",
      "swiftc *": "allow",
      "make *": "allow",
      "cmake *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "go *": "allow",
      "tofu *": "allow",
      "terraform *": "allow",
      "kubectl *": "allow",
      "helm *": "allow",
      "docker *": "allow",

      "sqlite3 *": "allow",
      "plutil *": "allow",
      "defaults *": "allow",
      "pgrep *": "allow",
      "nm *": "allow",
      "otool *": "allow",
      "lipo *": "allow",
      "codesign *": "allow",
      "log *": "allow",
      "sysctl *": "allow",
      "uname *": "allow",
      "sw_vers *": "allow",
      "env": "allow",
      "env *": "ask",
      "source *": "ask",
      "for *": "ask",

      "hypa *": "allow",
      "openspec *": "allow",

      "rm *": "ask",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "pkill *": "ask",
      "kill *": "ask",
      "security *": "ask",
      "sudo *": "ask"
    },

    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "grafana": "allow",
      "grafana:*": "allow"
    },

    "web_search": "allow",
    "subagent": "allow",
    "skill": { "*": "ask" },

    "external_directory": {
      "*": "ask",
      "~/code/*": "allow",
      "~/.cargo/*": "allow",
      "~/.rustup/*": "allow",
      "~/Library/Application Support/*": "allow",
      "~/Library/Preferences/*": "allow"
    }
  }
}
